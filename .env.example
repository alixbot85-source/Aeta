NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aeta:change_me@localhost:5432/aeta
JWT_ACCESS_SECRET=replace-with-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DEMO_MODE=true
VITE_DEMO_MODE=true
# Optional separately-hosted keyless G4F adapter (never put commercial API keys here)
VITE_AI_API_URL=http://localhost:8000
AI_ALLOWED_ORIGINS=http://localhost:5173
MARKET_DATA_PROVIDER=NOT_CONFIGURED
PAYMENT_PROVIDER=NOT_CONFIGURED
# Frontend/mobile API base URL. Required for Android/fullstack builds; leave empty only for local static Demo.
VITE_API_URL=http://localhost:4000
# Comma separated web/mobile origins allowed by backend CORS.
APP_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Set true when API and app are on different HTTPS origins and cookies must be sent cross-site.
CROSS_SITE_COOKIES=false
