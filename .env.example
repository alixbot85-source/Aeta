# DeepSeek is the only AI provider supported by Aeta.
# Never put a real key in Git; set it only in the server runtime environment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Core runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://aeta:aeta@postgres:5432/aeta?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-with-a-long-random-value
ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
WORKSPACES_ROOT=/data/workspaces

# Browser-facing web config; no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
