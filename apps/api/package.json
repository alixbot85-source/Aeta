{
  "name": "@aeta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig ../../tsconfig.base.json watch src/server.ts",
    "start": "tsx --tsconfig ../../tsconfig.base.json src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "echo \"Prisma schema is checked in; runtime uses the PostgreSQL mapper.\"",
    "prisma:migrate": "tsx --tsconfig ../../tsconfig.base.json src/db/migrate.ts",
    "prisma:dev": "tsx --tsconfig ../../tsconfig.base.json src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aeta/agent": "*",
    "@aeta/ai": "*",
    "@aeta/filesystem": "*",
    "@aeta/git": "*",
    "@aeta/shared": "*",
    "@aeta/terminal": "*",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.20.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "supertest": "^7.0.0"
  }
}
